collectBtn.MouseButton1Click:Connect(function()
    local targetCount = tonumber(bookInput.Text) or 7
    local collected = 0
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for _, item in ipairs(Workspace:GetDescendants()) do
        if collected >= targetCount then break end
        local itemName = string.lower(item.Name)
        if string.find(itemName, "notebook") or string.find(itemName, "book") then
            if item:IsA("BasePart") then
                if hrp then
                    hrp.CFrame = item.CFrame
                    task.wait(0.1)
                end
                firetouchinterest(hrp, item, 0)
                firetouchinterest(hrp, item, 1)
                collected = collected + 1
            elseif item:IsA("Model") and item.PrimaryPart then
                if hrp then
                    hrp.CFrame = item.PrimaryPart.CFrame
                    task.wait(0.1)
                end
                collected = collected + 1
            end
            local cd = item:FindFirstChildOfClass("ClickDetector") or item.Parent:FindFirstChildOfClass("ClickDetector")
            if cd then
                fireclickdetector(cd)
            end
        end
    end

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if string.find(string.lower(stat.Name), "notebook") or string.find(string.lower(stat.Name), "book") then
                stat.Value = targetCount
            end
        end
    end
end)

