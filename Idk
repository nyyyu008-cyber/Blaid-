-- -------------------------------------------------------------
-- Master Loops & Mechanics Override
-- -------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if hum then
            hum.WalkSpeed = States.WalkSpeed
            hum.JumpPower = States.JumpPower
        end

        -- 1. God Mode Bypass (Anti-Baldi & Anti-Principal)
        if States.GodMode then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanTouch = false end
            end
            for _, npc in ipairs(Workspace:GetDescendants()) do
                local npcName = string.lower(npc.Name)
                if string.find(npcName, "baldi") or string.find(npcName, "principal") then
                    if npc:IsA("BasePart") then
                        npc.CanTouch = false
                    elseif npc:IsA("Model") and npc.PrimaryPart and hrp then
                        local dist = (hrp.Position - npc.PrimaryPart.Position).Magnitude
                        if dist < 8 then
                            npc:SetPrimaryPartCFrame(npc.PrimaryPart.CFrame + Vector3.new(0, 50, 0))
                        end
                    end
                end
            end
        end

        -- 2. Anti-Bully
        if States.AntiBully then
            for _, npc in ipairs(Workspace:GetDescendants()) do
                if string.find(string.lower(npc.Name), "bully") then
                    if npc:IsA("Model") and npc.PrimaryPart then
                        npc:SetPrimaryPartCFrame(CFrame.new(0, -500, 0))
                    elseif npc:IsA("BasePart") then
                        npc.CanCollide = false
                        npc.Transparency = 1
                    end
                end
            end
        end

        -- 3. Infinite Stamina
        if States.InfiniteStamina then
            for _, v in ipairs(LocalPlayer:GetDescendants()) do
                if string.find(string.lower(v.Name), "stamina") and v:IsA("ValueBase") then
                    v.Value = 100
                end
            end
            for _, v in ipairs(char:GetDescendants()) do
                if string.find(string.lower(v.Name), "stamina") and v:IsA("ValueBase") then
                    v.Value = 100
                end
            end
        end

        -- 4. Infinite Items
        if States.InfiniteItems then
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, storedItem in ipairs(ItemStorage:GetChildren()) do
                    if not backpack:FindFirstChild(storedItem.Name) and not char:FindFirstChild(storedItem.Name) then
                        storedItem:Clone().Parent = backpack
                    end
                end
            end
        end

        -- 5. Auto Solve Question 3
        if States.AutoSolveQ3 then
            local mathUI = LocalPlayer.PlayerGui:FindFirstChild("MathScreen") or LocalPlayer.PlayerGui:FindFirstChild("NotebookGui")
            if mathUI then
                for _, btn in ipairs(mathUI:GetDescendants()) do
                    if btn:IsA("TextBox") or btn:IsA("TextButton") then
                        if string.find(string.lower(btn.Name), "answer") or string.find(string.lower(btn.Name), "q3") then
                            btn.Text = "42"
                        end
                    end
                end
            end
        end

        -- 6. Noclip
        if States.Noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end

    -- Book ESP Loop
    if States.ESPBooks then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local itemName = string.lower(obj.Name)
            if (string.find(itemName, "notebook") or string.find(itemName, "book")) then
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:FindFirstChild("BookESP") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "BookESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.3
                    highlight.Parent = obj

                    local bgui = Instance.new("BillboardGui")
                    bgui.Name = "BookTag"
                    bgui.AlwaysOnTop = true
                    bgui.Size = UDim2.new(0, 100, 0, 30)
                    bgui.StudsOffset = Vector3.new(0, 2, 0)
                    bgui.Parent = obj

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "📖 Notebook"
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 12
                    lbl.Parent = bgui
                end
            end
        end
    end
end)

